  { "tool": "draw_batch", "args": { "label": "contornos", "ops": [
    { "layer": "perna_tras", "op": "outline", "color": 0 },
    { "layer": "perna_frente", "op": "outline", "color": 0 },
    { "layer": "espada", "op": "outline", "color": 0 },
    { "layer": "corpo", "op": "outline", "color": 0 },
    { "layer": "pluma", "op": "outline", "color": 0 },
    { "layer": "escudo", "op": "outline", "color": 0 }
